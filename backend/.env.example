# Required application settings
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Optional comma-separated production storefront origins. Include both when your
# Namecheap domain serves at the apex and www hosts.
CLIENT_URLS=https://froyalamity.com,https://www.froyalamity.com
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/YOUR_DATABASE
JWT_SECRET=use-a-long-random-secret
JWT_EXPIRES_IN=7d

# Paystack secret key stays on the backend. Use sk_test_... while testing.
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_CURRENCY=NGN
# Optional: full URL for the storefront payment return page.
# PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/verify

# Optional Cloudinary image upload settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Resend email order notifications. Verify EMAIL_FROM in Resend first.
RESEND_API_KEY=re_...
EMAIL_FROM=Froyal Amity Store <orders@yourdomain.com>

# Optional WhatsApp Cloud API order notifications.
# Create/approve a template with two body variables: order reference and order status.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=order_status_update
WHATSAPP_TEMPLATE_LANGUAGE=en
